rules_version = '2';

// Paste this into Firebase console → Firestore → Rules, then click Publish.
// Each signed-in Google account can read and write only its own users/{uid}/... data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
